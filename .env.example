# ─── Environnement ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Cloudinary ──────────────────────────────────────────────────────────────
# Récupérer depuis : https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=ton_cloud_name
CLOUDINARY_API_KEY=ton_api_key
CLOUDINARY_API_SECRET=ton_api_secret

# ─── Shopify Admin API ───────────────────────────────────────────────────────
# Format du domaine : massacre-officiel.myshopify.com  (sans https://)
SHOPIFY_STORE_DOMAIN=massacre-officiel.myshopify.com

# Token d'accès Admin API (Custom App > "Admin API access token")
# Permissions requises : write_draft_orders, read_draft_orders
SHOPIFY_ADMIN_API_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
